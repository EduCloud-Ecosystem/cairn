  "retained_review_findings": [
    {
      "finding": "Memory claim/finalization could mutate after cancellation while waiting on mutex.",
      "status": "REPRODUCED before correction; corrected control PASS in focused and full suites.",
      "before_log": "mutex-cancellation-before.jsonl",
      "before_log_sha256": "08e29cc3eb24b9eb940a23c7f9378d3700701cd23b0298eb5e355884f770a098",
      "counts": "2 failing subcases plus their failing parent; not 3 independent defects."
    },
    {
      "finding": "A single PostgreSQL UPDATE with a cross-row NOT EXISTS guard can use a stale snapshot after waiting for the queue row.",
      "status": "SOURCE-INFERRED before fix; pre-fix runtime NOT RUN. New queue-row lock followed by fresh barrier SELECT; gated PostgreSQL lock-wait regression added. Local PostgreSQL runtime NOT RUN.",
      "primary_reference": "https://www.postgresql.org/docs/17/transaction-iso.html#XACT-READ-COMMITTED"
    },
    {
      "finding": "An unsuccessful claim write cannot establish a permanent tombstone when no record was committed.",
      "status": "Boundary documented and direct GradeJob initiation refused. Real Worker keeps the already-claimed row in_progress; rollback/reopen/repeated-direct-call control PASS with zero checkout/run."
    }
  ],
  "open_boundaries": [
    "Existing synthetic Outfitter adapter remains uninstalled; current runner interface has no external status API.",
    "Queue JobID/claim/GradingRun and delivery counters provide no compute reservation, attempt budget or refund authority.",
    "Claim never expires/reopens after persistence. Absent-record claim errors are held by in_progress queue state, not an invented tombstone.",
    "Direct internal GradeManagedJob calls outside the trusted Worker protocol, manual queue resets, old binaries and out-of-band DB changes are unsupported recovery routes.",
    "Backup rollback and a second restored admitting store can lose/duplicate authority; operational fencing remains OPEN.",
    "PostgreSQL runtime validation is deferred to the existing bounded CI database job; no live deployment qualification."
  ],
